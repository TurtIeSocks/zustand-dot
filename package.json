{
  "name": "zustand-dot",
  "version": "0.0.0-development",
  "description": "Zustand middleware for deep dot-path access and reactive hooks",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "prepare": "husky install",
    "commit": "cz"
  },
  "peerDependencies": {
    "react": ">=17",
    "zustand": ">=5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "react": "^19.2.4",
    "zustand": "^5.0.11",
    "@types/react": "^19.2.14",
    "@biomejs/biome": "^2.4.6",
    "vitest": "^3.2.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/check-mate/zustand-dot.git"
  },
  "keywords": [
    "zustand",
    "middleware",
    "dot-notation",
    "dot-path",
    "deep-access",
    "nested-state",
    "react",
    "state-management",
    "immutable",
    "hooks"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/check-mate/zustand-dot#readme",
  "bugs": {
    "url": "https://github.com/check-mate/zustand-dot/issues"
  },
  "license": "MIT"
}